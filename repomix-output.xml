        padding: 25px;
        border: 2px solid #e0e7ff; 
        box-shadow: 10px 10px 20px #e2e8f0, -10px -10px 20px #ffffff; 
        transition: all 0.4s ease;
        display: flex;
        align-items: flex-start;
        height: 100%;
    }

    .comment-card:hover {
        border-color: #3b71ed; 
        transform: translateY(-8px);
    }

    .quote-icon {
        color: #3b71ed;
        font-size: 30px;
        margin-left: 15px;
        opacity: 0.3;
    }

    .comment-body h6 {
