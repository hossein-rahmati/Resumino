          {% else %}
            <a href="{% url 'login' %}" class="text-slate-600 hover:text-blue-600">ورود</a>
            <a href="{% url 'register' %}" class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition">ثبت‌نام</a>
          {% endif %}
        </div>
      </div>
    </header>

    <main class="pt-24"> 
