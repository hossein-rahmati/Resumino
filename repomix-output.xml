  </head>
  <body class="bg-slate-50 text-slate-800 font-sans">
    
    <header id="mainHeader" class="fixed top-0 w-full z-50 bg-white/90 backdrop-blur-sm border-b border-slate-100 transition-all duration-300">
      <div class="max-w-6xl mx-auto px-4 py-4 flex justify-between items-center">
        <a href="{% url 'home' %}" class="text-xl font-bold text-blue-600">رزومینو</a>

        <div class="space-x-6 space-x-reverse flex items-center">
          <a href="{% url 'home' %}" class="text-slate-600 hover:text-blue-600">خانه</a>
          <a href="{% url 'about' %}" class="text-slate-600 hover:text-blue-600">درباره ما</a>
          <a href="{% url 'contact' %}" class="text-slate-600 hover:text-blue-600">تماس با ما</a>

          {% if user.is_authenticated %}
            <a href="{% url 'dashboard' %}" class="text-blue-600 font-bold">داشبورد</a>
           
            <form method="post" action="{% url 'logout' %}" class="inline">
