                </div>
            </div>
            <button id="close-chat" class="hover:bg-white/10 p-2 rounded-lg transition">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>
        </div>

        <!-- Chat Body -->
        <div id="chat-messages" class="h-[380px] overflow-y-auto p-5 space-y-4 bg-slate-50/50">
            <!-- AI Message -->
            <div class="flex items-start gap-3">
                <div class="w-8 h-8 rounded-lg bg-blue-100 text-blue-600 flex items-center justify-center flex-shrink-0">
                    <i data-lucide="bot" class="w-5 h-5"></i>
                </div>
                <div class="bg-white p-3 rounded-2xl rounded-tr-none shadow-sm border border-slate-100 text-sm leading-7 text-slate-700">
                    سلام کاربر جان! چطوری می‌تونم امروز کمکت کنم تا رزومه‌ت رو حرفه‌ای‌تر کنی؟
                </div>
            </div>
        </div>

        <!-- Chat Input -->
        <div class="p-4 bg-white border-t border-slate-100">
            <form id="chat-form" class="relative">
                <input type="text" id="user-input" 
                    class="w-full pl-12 pr-4 py-3 bg-slate-100 border-none rounded-2xl text-sm focus:ring-2 focus:ring-blue-500 transition" 
                    placeholder="سوالت رو اینجا بپرس...">
                <button type="submit" class="absolute left-2 top-1/2 -translate-y-1/2 w-9 h-9 bg-blue-600 text-white rounded-xl flex items-center justify-center hover:bg-blue-700 transition shadow-lg shadow-blue-200">
                    <i data-lucide="send" class="w-4 h-4"></i>
                </button>
            </form>
        </div>
    </div>

    <!-- Toggle Button -->
    <button id="toggle-chat" class="w-16 h-16 bg-slate-900 text-white rounded-2xl shadow-2xl flex items-center justify-center hover:bg-blue-600 hover:-translate-y-1 transition-all duration-300 group">
        <i data-lucide="message-square-more" class="w-8 h-8 group-hover:hidden"></i>
        <i data-lucide="sparkles" class="w-8 h-8 hidden group-hover:block animate-pulse"></i>
    </button>
</div>
<script>
document.addEventListener('DOMContentLoaded', function() {
    const toggleBtn = document.getElementById('toggle-chat');
    const closeBtn = document.getElementById('close-chat');
    const chatWindow = document.getElementById('chat-window');
    const chatForm = document.getElementById('chat-form');
    const chatMessages = document.getElementById('chat-messages');
    const userInput = document.getElementById('user-input');

    // باز و بسته کردن چت
    toggleBtn.addEventListener('click', () => {
        chatWindow.classList.toggle('hidden');
        chatWindow.classList.toggle('flex');
        // آیکون‌های لوساید را مجدد رندر کن (اگر نیاز بود)
        lucide.createIcons();
    });

    closeBtn.addEventListener('click', () => {
        chatWindow.classList.add('hidden');
        chatWindow.classList.remove('flex');
    });

    // ارسال پیام
    chatForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const text = userInput.value.trim();
    if (!text) return;

    addMessage(text, 'user');
    userInput.value = '';

    // نمایش وضعیت "در حال تایپ..."
    const loadingDiv = document.createElement('div');
    loadingDiv.id = 'ai-loading';
    loadingDiv.innerHTML = '<p class="text-xs text-slate-400 p-2">در حال فکر کردن...</p>';
    chatMessages.appendChild(loadingDiv);

    try {
        // ارسال پیام به سرور جنگو
        const response = await fetch('/api/ai-coach/', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                // 'X-CSRFToken': getCookie('csrftoken') // اگر نیاز به امنیت CSRF داشتی
            },
            body: JSON.stringify({ message: text })
        });

        const data = await response.json();
        
        // حذف وضعیت لودینگ و نمایش جواب واقعی
        document.getElementById('ai-loading').remove();
        addMessage(data.reply, 'ai');

    } catch (error) {
        document.getElementById('ai-loading').remove();
        addMessage("خطا در برقراری ارتباط با سرور.", 'ai');
    }
});


    function addMessage(text, sender) {
        const div = document.createElement('div');
        div.className = sender === 'user' ? 'flex items-start gap-3 flex-row-reverse' : 'flex items-start gap-3';
        
        const bgColor = sender === 'user' ? 'bg-blue-600 text-white rounded-tl-none' : 'bg-white text-slate-700 rounded-tr-none border border-slate-100';
        const icon = sender === 'user' ? 'user' : 'bot';
        const iconBg = sender === 'user' ? 'bg-slate-100 text-slate-600' : 'bg-blue-100 text-blue-600';

        div.innerHTML = `
            <div class="w-8 h-8 rounded-lg ${iconBg} flex items-center justify-center flex-shrink-0">
                <i data-lucide="${icon}" class="w-5 h-5"></i>
            </div>
            <div class="${bgColor} p-3 rounded-2xl shadow-sm text-sm leading-7">
                ${text}
            </div>
        `;
        
        chatMessages.appendChild(div);
        lucide.createIcons(); // برای نمایش آیکون‌های پیام جدید
        chatMessages.scrollTop = chatMessages.scrollHeight;
    }
});
</script>

{% endblock content %}
</file>

