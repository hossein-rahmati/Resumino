        font-weight: 800;
        margin-bottom: 5px;
        font-size: 1.1rem;
    }

    .comment-body p {
        color: #4a5568;
        font-size: 0.9rem;
        line-height: 1.7;
        margin-bottom: 10px;
    }

    .user-tag {
        display: inline-block;
