                    <!-- AI Chatbot Widget -->
<div id="ai-coach-wrapper" class="fixed bottom-6 left-6 z-50 flex flex-col items-end">
    
    <!-- Chat Window -->
    <div id="chat-window" class="hidden mb-4 w-[350px] md:w-[400px] bg-white rounded-[2rem] shadow-2xl border border-slate-100 overflow-hidden flex flex-col transition-all duration-300 ease-in-out transform scale-95 origin-bottom-left">
        
